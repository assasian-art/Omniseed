# =============================================================================
#  OmniSeed — .gitignore
# =============================================================================

# Build trees
build/
build-*/
out/

# Python venv (training tools; Colab/CI use the system python)
.venv/

# Model artifacts (large binaries are not checked in). models/ is an
# artifact drop-zone: DIRECT children are ignored by default; the committed
# exceptions (world vocab, hf-orig runtime code) are re-included at the end
# of this file — negations after models/* are load-bearing, keep the order.
models/*
!models/hf-orig/
*.ckpt
*.pth
*.pt
*.safetensors
*.gguf
*.ovocab

# Downloaded reference sources (URLs documented in the converters)
models/*.py
models/config.json
models/goose28_*.json
models/goose28_modeling.py
models/whisper-tiny-tokenizer.json

__pycache__/

# QAT training artifacts (checkpoint/masters are regenerable; corpus cache is
# a deterministic transform of the wikitext-103 download + in-repo vocab)
models/corpus/
models/qat_ckpt*.pt
qat_log.txt

# Compiler intermediates (stray ad-hoc builds)
*.obj
*.pdb

# Regenerated docs (tools/md2html.py docs/OMNISEED_MASTER_SPEC.md)
docs/OMNISEED_MASTER_SPEC.html

# Local runtime state (memory crystals, skills, fingerprints)
state/

# IDE / OS noise
.vs/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Freebuff client state
.freebuff/

# ---------------------------------------------------------------------------
# Committed world vocab (1.0 MB): ships in-repo so fresh clones / Colab train
# out of the box — resolve_vocab() reads tools/data/ first, models/ second.
# These negations are deliberate exceptions to any future artifact globs.
# ---------------------------------------------------------------------------
!tools/data/rwkv_vocab_v20230424.txt
!models/rwkv_vocab_v20230424.txt
